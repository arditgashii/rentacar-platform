# Local run without Docker (SQLite, photos on disk, events in memory).
# With Docker, docker-compose.yml sets everything and this file is not needed.
DATABASE_URL=sqlite+aiosqlite:///./drivenow.db
STORAGE_BACKEND=local
MESSAGING_BACKEND=memory
SECRETS_BACKEND=env
JWT_SECRET=local-only-secret-change-me-at-least-32-characters

# on = the four intentional bugs are active (see docs/INTENTIONAL-BUGS.md), off = correct behaviour
DRIVENOW_BUGS=on

# Every seeded account uses this password (admin1..3@drivenow.test, client1..6@drivenow.test)
SEED_PASSWORD=DriveNow!2026

# mock writes descriptions locally; anthropic needs ANTHROPIC_API_KEY
LLM_PROVIDER=mock
LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# Set to an OTLP HTTP endpoint (for example http://localhost:4318) to export traces
OTEL_EXPORTER_OTLP_ENDPOINT=
